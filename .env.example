# Copy this file to .env and replace the two absolute paths below.

# Local clone of the 3W repository.
THREE_W_REPOSITORY_PATH=/absolute/path/to/3W

# Complete 3W Dataset v2.0.0 directory containing <class>/*.parquet files.
THREE_W_DATASET_PATH=/absolute/path/to/3W-dataset

# Challenge artifacts. python-dotenv expands variables written as ${NAME}.
THREE_W_CHALLENGE_PATH=${THREE_W_REPOSITORY_PATH}/toolkit/demos/challenge
THREE_W_CHALLENGE_MATRIX_PATH=${THREE_W_CHALLENGE_PATH}/instance_split_matrix.csv
THREE_W_CHALLENGE_SPLIT_DIR=${THREE_W_CHALLENGE_PATH}/splits

# Shared by matrix generation and the repeatable baseline models.
THREE_W_CHALLENGE_RANDOM_SEED=42
