# Copy this file to .env and replace the dataset path with your local copy.
# Relative paths are resolved from the repository root.

# Complete 3W Dataset v2.0.0 directory containing <class>/*.parquet files.
THREE_W_DATASET_PATH=/absolute/path/to/3W/dataset

# Fixed challenge matrix and its deterministic Toolkit-compatible outputs.
THREE_W_WORKSHOP_MATRIX_PATH=toolkit/demos/workshop/instance_split_matrix.csv
THREE_W_WORKSHOP_SPLIT_DIR=toolkit/demos/workshop/splits

# Use 0 for the complete workshop run; use 10 only for a quick smoke check.
THREE_W_WORKSHOP_MAX_INSTANCES_PER_CLASS=0
THREE_W_WORKSHOP_SAMPLES_PER_LABEL_PER_INSTANCE=100

# Shared by matrix generation and the repeatable notebook models.
THREE_W_WORKSHOP_RANDOM_SEED=42
